{
  "manifest_version": 3,
  "name": "PorqueMangaVoy",
  "version": "0.1.0",
  "description": "Recuerda por qué capítulo de manga o episodio de anime vas, en cualquier web. Sincroniza entre PCs y opcionalmente con AniList.",
  "permissions": ["storage", "tabs", "activeTab", "scripting", "identity"],
  "host_permissions": ["https://graphql.anilist.co/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/parser.js", "lib/store.js", "lib/anilist.js", "background.js"]
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "PorqueMangaVoy",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+M" }, "description": "Abrir PorqueMangaVoy" }
  },
  "browser_specific_settings": {
    "gecko": { "id": "porquemangavoy@edu.local", "strict_min_version": "121.0" }
  }
}
